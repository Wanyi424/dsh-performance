{
  "name": "dsh-performance",
  "version": "0.7.1",
  "description": "DSH 运行监控：侧栏实时读数与异常提醒；页面先给结论，再用 CPU、内存、界面响应三轨联动趋势和「谁在占用」一张表找到原因，插件按后台实时拆分，详情在侧边抽屉里；可复制诊断报告。",
  "type": "module",
  "license": "MIT",
  "author": "Wanyi424",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanyi424/dsh-performance.git"
  },
  "homepage": "https://github.com/Wanyi424/dsh-performance#readme",
  "bugs": {
    "url": "https://github.com/Wanyi424/dsh-performance/issues"
  },
  "engines": { "node": ">=22", "dsh": "^0.2.0-rc.2" },
  "os": ["win32"],
  "icon": "./icon.svg",
  "exports": { ".": "./lib/host.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["lib", "native", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "typecheck": "tsc --noEmit", "test": "node --import tsx --test tests/*.test.ts", "build": "node scripts/build.mjs", "check:browser": "node --import tsx scripts/browser-check.ts", "check:collector": "node --import tsx scripts/collector-check.ts", "pack:plugin": "npm run typecheck && npm test && npm run build && npm pack --pack-destination dist" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-connection"] } },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.3.0", "esbuild": "^0.25.0", "playwright": "^1.64.1", "react": "^19.0.0", "react-dom": "^19.3.1", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
